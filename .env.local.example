# ───────────────────────────────────────────────────────────────
# Runs with NO keys (sample data + curated editorial). Add keys to
# progressively enable live features. Add to Vercel with:
#   vercel env add <NAME> production
# ───────────────────────────────────────────────────────────────

# Live macro data (free): https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# ── Phase 3.1: daily editorial snapshot ──
# Protects the cron generate endpoint (Vercel sends it to crons automatically).
CRON_SECRET=

# LLM interpretation — turns clustered news into grounded daily themes.
# Provider priority: Gemini first, Anthropic as automatic backup.
# Get a Gemini key at https://aistudio.google.com/apikey; verify model access/quota.
GEMINI_API_KEY=
# Shared by the Next.js app AND Python newsletter extractor. Use a compatible Gemini 3 model.
GEMINI_MODEL=gemini-3.5-flash-lite
# LLM timeouts (ms). Defaults suit Vercel Pro (maxDuration 180s).
GEMINI_TIMEOUT_MS=90000
ANTHROPIC_TIMEOUT_MS=60000
# Optional backup (pay-as-you-go). Used only if Gemini errors/empty.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001

# ── News adapters (add any/all — more keys = more articles) ──
# Marketaux   100 req/day  https://www.marketaux.com
MARKETAUX_API_KEY=
# NewsData.io 200 credits/day  https://newsdata.io
NEWSDATA_API_KEY=
# Finnhub     60 req/min  https://finnhub.io
FINNHUB_API_KEY=
# Alpha Vantage 25 req/day (optional)  https://www.alphavantage.co
ALPHAVANTAGE_API_KEY=

# Vercel KV (Upstash) — added automatically when you provision KV in Vercel.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ── Newsletter mailbox (api/cron-bloomberg.py, IMAP fetch) ──
# Was previously undocumented here despite being required by that script.
# AOL Mail; IMAP_HOST/IMAP_EMAIL/IMAP_PASSWORD preferred, AOL_* kept for back-compat.
IMAP_HOST=imap.aol.com
IMAP_EMAIL=
IMAP_PASSWORD=

# ── V5.13: Daily Risk Brief email (app/api/cron/editorial/route.ts) ──
# After the daily snapshot generates, a PDF covering the same sections as the Home tab
# (Daily Risk Brief, What Changed, Top Developments, CRO Conversation, Editorial
# Intelligence, Japan & Asia Watch, Radar) is emailed to this address. Sent FROM the same
# mailbox IMAP_EMAIL/IMAP_PASSWORD already fetches newsletters from (SMTP, not IMAP) — no
# separate sender credentials needed. Sending is silently skipped (not an error) if this
# or IMAP_EMAIL/IMAP_PASSWORD is unset.
#
# V5.13.2 — ON HOLD by default. The whole feature is still built and gated by
# DAILY_BRIEF_ENABLED below, not by unsetting this recipient address — set both when you
# want to test/re-enable it.
DAILY_BRIEF_RECIPIENT_EMAIL=
# Only needed if the mailbox ever moves off AOL — defaults assume AOL's SMTP.
# SMTP_HOST=smtp.aol.com
# SMTP_PORT=465
# Master on/off switch for the Daily Risk Brief email — must be exactly "true" to send.
# Unset/anything else = on hold (snapshot generation still runs as normal either way).
# DAILY_BRIEF_ENABLED=true
